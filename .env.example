# Server Configuration
PORT=8766
HOST=127.0.0.1
DEBUG=false

# Google Vertex AI Configuration
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.7-flash
VERTEX_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Optional: Direct Gemini API Key (if not using Google Cloud ADC / gcloud)
# GEMINI_API_KEY=

# Optional: Path to custom gcloud executable (auto-detected from PATH by default)
# GCLOUD_BIN=
